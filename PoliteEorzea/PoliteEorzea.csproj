<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <Author>AHAKuo</Author>
    <Name>Polite Eorzea</Name>
    <Punchline>Say hello and thank your party with one command, or automatically in duties.</Punchline>
    <Description>Polite Eorzea sends a greeting or a farewell to your party (or alliance) from your own list of messages.

• /hi and /bye send a random greeting or farewell right away.
• Auto mode greets when you enter an instanced duty and says thanks when it completes.
• Picks party or alliance chat automatically; skips solo duties.
• Fully editable message lists, delays and triggers in /polite.</Description>
    <Tags>chat;party;alliance;greeting;hello;thanks;duty;dungeon;raid;trial;social;quality-of-life;qol</Tags>
    <RepoUrl>https://github.com/AHAKuo/FFXIVPoliteEorzea</RepoUrl>
  </PropertyGroup>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
